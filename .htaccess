<IfModule mod_rewrite.c>
  Options -Indexes -MultiViews +SymLinksIfOwnerMatch

  RewriteEngine On
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
  RewriteCond %{HTTP:X-API-Key} ^(.*)
  RewriteRule .* - [E=HTTP_X_API_KEY:%1]
  RewriteCond %{HTTP:Origin} ^(.*)
  RewriteRule .* - [E=HTTP_ORIGIN:%1]
  RewriteCond %{HTTP:Access-Control-Request-Method} ^(.*)
  RewriteRule .* - [E=HTTP_ACCESS_CONTROL_REQUEST_METHOD:%1]
  RewriteCond %{HTTP:Access-Control-Request-Headers} ^(.*)
  RewriteRule .* - [E=HTTP_ACCESS_CONTROL_REQUEST_HEADERS:%1]
  RewriteCond %{HTTP:X-Forwarded-For} ^(.*)
  RewriteRule .* - [E=HTTP_X_FORWARDED_FOR:%1]
  RewriteCond %{HTTP:X-Forwarded-Proto} ^(.*)
  RewriteRule .* - [E=HTTP_X_FORWARDED_PROTO:%1]
  RewriteCond %{HTTP:X-Real-IP} ^(.*)
  RewriteRule .* - [E=HTTP_X_REAL_IP:%1]
  RewriteCond %{HTTP:X-Requested-With} ^(.*)
  RewriteRule .* - [E=HTTP_X_REQUESTED_WITH:%1]
  RewriteCond %{HTTP:Content-Type} ^(.*)
  RewriteRule .* - [E=CONTENT_TYPE:%1]
  RewriteCond %{HTTP:Content-Length} ^(.*)
  RewriteRule .* - [E=CONTENT_LENGTH:%1]
  RewriteCond %{REQUEST_URI}::$1 ^(/.+)/(.*)::\2$
  RewriteRule ^(.*) - [E=BASE:%1]
  RewriteRule ^\..*$ - [F,L]
  RewriteRule ^(?:app|component|library)(?:/|$) - [F,L,NC]
  RewriteRule ^mystack-extension(?:-main)?(?:/|$) - [F,L,NC]
  RewriteRule ^src/(?:cache/.*\.php|js/.*\.php)$ - [F,L,NC]
  # CLI source/launchers and framework metadata are local-only. Keep this
  # explicit rule in addition to FilesMatch for Apache/LiteSpeed portability.
  RewriteRule ^(?:database\.php|database_schema\.sql|AGENTS\.md|CONTRIBUTING\.md|MANUAL_BN\.md|README\.md|LICENSE|NOTICE|mystack(?:\.cmd)?)$ - [F,L,NC]
  RewriteRule ^favicon\.ico$ favicon.svg [L,NC]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule . %{ENV:BASE}/index.php [QSA,L]
</IfModule>
<FilesMatch "(^\..*|^(?!index\.php$).*\.php$|composer\.(json|lock)|\.(env|git|log|ini|sql|sqlite|db|sh|cmd|bat|bash|bak|backup|yml|yaml)$|^(?:AGENTS\.md|CONTRIBUTING\.md|MANUAL_BN\.md|README\.md|LICENSE|NOTICE|mystack(?:\.cmd)?)$|mystack\.)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "^favicon\.svg$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
