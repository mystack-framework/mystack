        $days = max(1, min(3650, (int) ($options['days'] ?? 30))); $cutoff = time() - ($days * 86400); $targets = [];
        foreach (['css','js','php'] as $section) foreach (glob(ROOT_DIR . '/src/cache/' . $section . '/*') ?: [] as $file) if (is_file($file) && filemtime($file) < $cutoff) $targets[] = $file;
        if ($targets === []) { self::emit(['status' => true, 'removed' => 0], $options); return 0; }
        if (!self::confirm('Remove ' . count($targets) . " cache file(s) older than {$days} days?", $options)) { warning('Cache prune cancelled.'); return 0; }
        $removed = 0; foreach ($targets as $file) if (@unlink($file)) $removed++;
        self::emit(['status' => $removed === count($targets), 'removed' => $removed, 'selected' => count($targets)], $options); return $removed === count($targets) ? 0 : 1;
