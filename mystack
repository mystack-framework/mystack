    public static function configureDatabase(): bool {
        if (!class_exists('PHDB')) return false;
        $source = is_file(ROOT_DIR . '/index.php') ? (string) file_get_contents(ROOT_DIR . '/index.php') : '';
        foreach (explode("\n", str_replace(["\r\n", "\r"], "\n", $source)) as $line) {
            $trimmed = ltrim($line);
            if (str_starts_with($trimmed, '//') || str_starts_with($trimmed, '#') || str_starts_with($trimmed, '*')) continue;
            foreach (['host','username','password','dbname','charset'] as $property) {
                if (preg_match('/PHDB::\$' . $property . '\s*=\s*([\'"])(.*?)\1\s*;/', $line, $match)) PHDB::${$property} = stripcslashes($match[2]);
            }
        }
        return is_string(PHDB::$host) && PHDB::$host !== '' && is_string(PHDB::$username) && PHDB::$username !== '' && is_string(PHDB::$dbname) && PHDB::$dbname !== '';
    }

