    private static function extensionCheck(array $options): int {
        $aiDocumentation = MyStackDocs::check();
        $documentationProblems = $aiDocumentation['errors'] ?? [];
        if (($aiDocumentation['libraries'] ?? 0) !== 31) {
            $documentationProblems[] = 'API catalog covers ' . ($aiDocumentation['libraries'] ?? 0) . ' libraries, expected 31.';
        }
        if (($aiDocumentation['public_methods'] ?? 0) <= 500) {
            $documentationProblems[] = 'API catalog indexes only ' . ($aiDocumentation['public_methods'] ?? 0) . ' public methods.';
        }
        foreach (['llms.txt', 'llms-full.txt', 'docs/index.html'] as $requiredFile) {
            if (!is_file(ROOT_DIR . '/' . $requiredFile)) $documentationProblems[] = $requiredFile . ' is missing.';
        }
        foreach (['robots.txt', 'sitemap.xml'] as $forbiddenFile) {
            if (is_file(ROOT_DIR . '/' . $forbiddenFile)) {
                $documentationProblems[] = 'static ' . $forbiddenFile . ' must not exist; PHRO serves it dynamically.';
            }
        }
        $phroSource = (string) file_get_contents(ROOT_DIR . '/library/PHRO.php');
        if (!str_contains($phroSource, 'self::get("/robots.txt"')) $documentationProblems[] = 'PHRO robots.txt route is missing.';
        if (!str_contains($phroSource, 'self::get("/sitemap.xml"')) $documentationProblems[] = 'PHRO sitemap.xml route is missing.';
        $documentationOk = $documentationProblems === [];

        $extensionRoot = ROOT_DIR . '/mystack-extension-main';
        $extensionPackage = is_file($extensionRoot . '/package.json') ? json_decode((string) file_get_contents($extensionRoot . '/package.json'), true) : null;
        $extensionSnippets = is_file($extensionRoot . '/snippets/snippets.json') ? json_decode((string) file_get_contents($extensionRoot . '/snippets/snippets.json'), true) : null;
        $extensionSource = is_file($extensionRoot . '/extension.js') ? (string) file_get_contents($extensionRoot . '/extension.js') : '';
        $extensionStubOk = false;
        $extensionStubPath = $extensionRoot . '/stubs/mystack-stubs.php';
        if (is_file($extensionStubPath)) {
            try {
                token_get_all((string) file_get_contents($extensionStubPath), TOKEN_PARSE);
                $extensionStubOk = true;
            } catch (Throwable) { $extensionStubOk = false; }
        }
        $extensionVsixOk = false;
        $extensionVsix = $extensionRoot . '/mystack-helper-' . (string) ($extensionPackage['version'] ?? '') . '.vsix';
        if (is_file($extensionVsix) && class_exists('ZipArchive')) {
            $archive = new ZipArchive();
            if ($archive->open($extensionVsix) === true) {
                $extensionVsixOk = $archive->locateName('extension.vsixmanifest', ZipArchive::FL_NOCASE) !== false
                    && $archive->locateName('extension/package.json', ZipArchive::FL_NOCASE) !== false;
                $archive->close();
            }
        }
        $extensionProblems = [];
        if (!is_array($extensionPackage)) {
            $extensionProblems[] = 'mystack-extension-main/package.json is missing or invalid.';
        } else {
            if (($extensionPackage['name'] ?? '') !== 'mystack-helper') {
                $extensionProblems[] = "package name is '" . ($extensionPackage['name'] ?? '') . "', expected 'mystack-helper'.";
            }
            if (($extensionPackage['publisher'] ?? '') !== 'Sakibweb') {
                $extensionProblems[] = "publisher is '" . ($extensionPackage['publisher'] ?? '') . "', expected 'Sakibweb'.";
            }
        }
        if (!is_array($extensionSnippets)) {
            $extensionProblems[] = 'snippets/snippets.json is missing or invalid.';
        } elseif (count($extensionSnippets) <= 2000) {
            $extensionProblems[] = 'only ' . count($extensionSnippets) . ' snippets, expected more than 2000.';
        }
        if (!$extensionStubOk) $extensionProblems[] = 'stubs/mystack-stubs.php is missing or contains PHP syntax errors.';
        if (!$extensionVsixOk) $extensionProblems[] = 'mystack-helper-' . (string) ($extensionPackage['version'] ?? '?') . '.vsix is missing or fails ZIP manifest validation.';
