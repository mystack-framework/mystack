function runDoctorLegacyUnsafe($dirPaths) {
    throw new LogicException('Legacy mutating doctor is disabled; use runDoctor() instead.');
    echo "\n";
    printColor(" 🩺 MyStack Doctor - Highly Advanced Code Diagnosis & Repair \n", "1;42;97");
    echo "\n";
    
    $totalScanned = 0;
    $totalFixed = 0;
    
    foreach ($dirPaths as $dirPath) {
        if (!is_dir($dirPath)) continue;
        
        $files = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($dirPath));
        
        foreach ($files as $file) {
            if ($file->isFile() && $file->getExtension() === 'php') {
                $totalScanned++;
                $filePath = $file->getPathname();
                $content = file_get_contents($filePath);
                $originalContent = $content;
                $filename = pathinfo($filePath, PATHINFO_FILENAME);
                $isModified = false;
                $fixesApplied = [];

                // 1. Remove UTF-8 BOM if present (breaks headers)
                $bom = pack('H*','EFBBBF');
                if (preg_match("/^$bom/", $content)) {
                    $content = preg_replace("/^$bom/", '', $content);
                    $fixesApplied[] = "Removed UTF-8 BOM (Byte Order Mark)";
                    $isModified = true;
                }

                // 2. Handle completely empty files
                if (trim($content) === '') {
                    $content = "<?php\n\n";
                    $fixesApplied[] = "Initialized empty file with PHP tag";
                    $isModified = true;
                }

                // 3. Convert short open tags to standard tags (<? -> <?php)
                // Need to be careful not to replace <?= (echo short tag)
                if (preg_match('/<\?(?!php|=)/i', $content)) {
                    $content = preg_replace('/<\?(?!php|=)\s*/i', "<?php\n", $content);
                    $fixesApplied[] = "Converted short open tags (<?) to standard tags (<?php)";
                    $isModified = true;
                }

                // 4. Check for missing <?php tag (if it's not a pure HTML view)
                if (strpos($content, '<?php') === false && strpos($content, '<?=') === false && strpos(strtolower($content), '<html') === false) {
                    $content = "<?php\n" . ltrim($content);
                    $fixesApplied[] = "Added missing <?php tag";
                    $isModified = true;
                }
                
                // 5. Enforce single trailing newline at EOF (PSR standard)
                $trimmedContent = rtrim($content);
                if ($trimmedContent . "\n" !== $content) {
                    $content = $trimmedContent . "\n";
                    $fixesApplied[] = "Enforced single trailing newline (PSR standard)";
                    $isModified = true;
                }

                // 6. Check for class name mismatch (class name should match filename if it's a class file)
                if (preg_match('/class\s+([a-zA-Z0-9_]+)\s*/i', $content, $matches)) {
                    $className = $matches[1];
                    if ($className !== $filename) {
                         // Attempt to fix class name mismatch automatically
                         $content = preg_replace('/class\s+' . $className . '\s*/i', "class {$filename} ", $content);
                         $fixesApplied[] = "Fixed class name mismatch: '{$className}' -> '{$filename}'";
                         $isModified = true;
                    }
                }

                // 7. Fix incorrect file permissions (Should be 0644 for PHP files)
                $currentPerms = substr(sprintf('%o', fileperms($filePath)), -4);
                if ($currentPerms !== '0644' && $currentPerms !== '0664') {
                    if (chmod($filePath, 0644)) {
                         $fixesApplied[] = "Fixed unsafe file permissions ($currentPerms -> 0644)";
                         $isModified = true;
                    }
                }

                if ($isModified && $content !== $originalContent) {
                    // Try to save
                    if (file_put_contents($filePath, $content) !== false) {
                        $totalFixed++;
                        printColor("[FIXED] ", "1;32");
                        echo str_replace(ROOT_DIR, '', $filePath) . "\n";
                        foreach ($fixesApplied as $fix) {
                            if (strpos($fix, 'permission') === false || $content !== $originalContent) {
                                echo "        - $fix\n";
                            }
                        }
                    } else {
                        printColor("[ERROR] ", "1;31");
                        echo "Failed to write to $filePath\n";
                    }
                } elseif ($isModified && count($fixesApplied) > 0) {
                     // Permission only fix
                     $totalFixed++;
                     printColor("[FIXED] ", "1;32");
                     echo str_replace(ROOT_DIR, '', $filePath) . "\n";
                     foreach ($fixesApplied as $fix) {
                          echo "        - $fix\n";
                     }
                }
                
                // 8. Syntax check using php -l
                exec("php -l " . escapeshellarg($filePath) . " 2>&1", $output, $returnVar);
                if ($returnVar !== 0) {
                     printColor("[SYNTAX ERROR] ", "1;31");
                     echo str_replace(ROOT_DIR, '', $filePath) . "\n";
                     echo "               " . implode("\n               ", $output) . "\n";
                }
            }
        }
    }
    
    echo "\n";
    printColor(" 📊 Doctor Report (ডাক্তারের রিপোর্ট): \n", "1;44;97");
    echo "  Total files scanned (মোট স্ক্যান করা ফাইল): $totalScanned\n";
    echo "  Total files auto-fixed (মোট ফাইল স্বয়ংক্রিয়ভাবে মেরামত করা হয়েছে): $totalFixed\n";
    
    if ($totalFixed > 0) {
        echo "  \033[1;32mMyStack Doctor successfully repaired structure, formatting, and naming issues automatically! (মাইস্ট্যাক ডাক্তার সফলভাবে স্বয়ংক্রিয়ভাবে কাঠামোগত, ফরম্যাটিং এবং নামের সমস্যাগুলি সমাধান করেছে!)\033[0m\n";
    } else {
         echo "  \033[1;32mYour application is completely healthy! No issues found. (আপনার অ্যাপ্লিকেশন সম্পূর্ণ সুস্থ! কোনো সমস্যা পাওয়া যায়নি।)\033[0m\n";
    }
    echo "\n";
}

function runDoctor(array $dirPaths, bool $applyFixes = false): bool {
    MyStackTui::header('Framework Doctor  •  ' . ($applyFixes ? 'safe repair mode' : 'read-only diagnosis'));
    MyStackTui::section('Code and filesystem scan');

    $totalScanned = 0;
    $totalIssues = 0;
    $totalFixed = 0;
    $syntaxErrors = 0;

    foreach ($dirPaths as $dirPath) {
        if (!is_dir($dirPath)) {
            continue;
        }

        $files = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($dirPath, FilesystemIterator::SKIP_DOTS)
        );

        foreach ($files as $file) {
            if (!$file->isFile() || strtolower($file->getExtension()) !== 'php') {
                continue;
            }

            $totalScanned++;
            $filePath = $file->getPathname();
            $relativePath = str_replace(ROOT_DIR, '', $filePath);
            $content = file_get_contents($filePath);
            if ($content === false) {
                $totalIssues++;
                printColor("[READ ERROR] ", "1;31");
                echo $relativePath . "\n";
                continue;
            }

            $candidate = $content;
            $safeFixes = [];
            $diagnostics = [];
            $bom = pack('H*', 'EFBBBF');

            if (str_starts_with($candidate, $bom)) {
                $candidate = substr($candidate, strlen($bom));
                $safeFixes[] = 'Remove UTF-8 BOM';
            }
            if (trim($candidate) === '') {
                $candidate = "<?php\n";
                $safeFixes[] = 'Initialize empty PHP file';
            }
            if (preg_match('/<\?(?!php|=)/i', $candidate)) {
                $candidate = preg_replace('/<\?(?!php|=)\s*/i', "<?php\n", $candidate);
                $safeFixes[] = 'Convert short open tags';
            }

            $normalized = rtrim($candidate) . "\n";
            if ($normalized !== $candidate) {
                $candidate = $normalized;
                $safeFixes[] = 'Normalize trailing newline';
            }

            $filename = pathinfo($filePath, PATHINFO_FILENAME);
            $tokens = token_get_all($candidate);
            $declaredClass = null;
            for ($tokenIndex = 0, $tokenCount = count($tokens); $tokenIndex < $tokenCount; $tokenIndex++) {
                if (!is_array($tokens[$tokenIndex]) || $tokens[$tokenIndex][0] !== T_CLASS) {
                    continue;
                }
                for ($nameIndex = $tokenIndex + 1; $nameIndex < $tokenCount; $nameIndex++) {
                    if (is_array($tokens[$nameIndex]) && $tokens[$nameIndex][0] === T_STRING) {
                        $declaredClass = $tokens[$nameIndex][1];
                        break 2;
                    }
                    if ($tokens[$nameIndex] === '{') {
                        break;
                    }
                }
            }
            if ($declaredClass !== null && $declaredClass !== $filename) {
                $diagnostics[] = "Class '{$declaredClass}' does not match filename '{$filename}' (manual review required)";
            }

            $currentPerms = substr(sprintf('%o', fileperms($filePath)), -4);
            $permissionIssue = DIRECTORY_SEPARATOR !== '\\'
                && !in_array($currentPerms, ['0644', '0664'], true);
            if ($permissionIssue) {
                $safeFixes[] = "Set permissions {$currentPerms} -> 0644";
            }

            $hasContentFix = $candidate !== $content;
            if ($hasContentFix || $permissionIssue || $diagnostics) {
                $totalIssues++;
                printColor($applyFixes ? '[CHECK] ' : '[ISSUE] ', $applyFixes ? '1;33' : '1;31');
                echo $relativePath . "\n";
                foreach (array_merge($safeFixes, $diagnostics) as $message) {
                    echo "        - {$message}\n";
                }
            }

            $fileFixed = false;
            if ($applyFixes && $hasContentFix) {
                if (file_put_contents($filePath, $candidate, LOCK_EX) === false) {
                    printColor("[WRITE ERROR] ", "1;31");
                    echo $relativePath . "\n";
                } else {
                    $fileFixed = true;
                }
            }
            if ($applyFixes && $permissionIssue) {
                if (chmod($filePath, 0644)) {
                    $fileFixed = true;
                } else {
                    printColor("[PERMISSION ERROR] ", "1;31");
                    echo $relativePath . "\n";
                }
            }
            if ($fileFixed) {
                $totalFixed++;
                printColor("[FIXED] ", "1;32");
                echo $relativePath . "\n";
            }

            try {
                token_get_all($candidate, TOKEN_PARSE);
            } catch (ParseError $parseError) {
                $syntaxErrors++;
                printColor("[SYNTAX ERROR] ", "1;31");
                echo $relativePath . "\n";
                echo "               " . $parseError->getMessage() . "\n";
            }
        }
    }

    MyStackTui::section('Doctor summary');
    MyStackTui::badge('SCANNED', (string) $totalScanned, '1;46;30', '◆');
    MyStackTui::badge('ISSUES', (string) $totalIssues, $totalIssues === 0 ? '1;42;30' : '1;43;30', $totalIssues === 0 ? '+' : '!');
    MyStackTui::badge('FIXED', (string) $totalFixed, '1;45;97', '~');
    MyStackTui::badge('SYNTAX', $syntaxErrors === 0 ? 'Clean' : (string) $syntaxErrors, $syntaxErrors === 0 ? '1;42;30' : '1;41;97', $syntaxErrors === 0 ? '+' : 'x');

    $folderState = $GLOBALS['folderMapReport']
        ?? MyStackBrain::ensureFolderMap(ROOT_DIR, true);
    MyStackBrain::renderFolderMap($folderState);

    $intelligence = MyStackBrain::analyze(ROOT_DIR, $GLOBALS['appDir'], $GLOBALS['componentDir']);
    MyStackBrain::render($intelligence);

    return $syntaxErrors === 0
        && ($applyFixes || $totalIssues === 0)
        && !empty($folderState['status'])
        && !empty($intelligence['status']);
}

function runFrameworkAudit(string $reportTitle = 'MyStack Framework Audit'): bool {
    MyStackTui::header($reportTitle . '  •  deterministic framework verification');
    MyStackTui::section('Verification checks');

    $passed = 0;
    $failed = 0;
    $warnings = 0;
    $check = static function (string $label, bool $status, string $details = '') use (&$passed, &$failed): void {
        if ($status) {
            $passed++;
            printColor("[PASS] ", "1;32");
        } else {
            $failed++;
            printColor("[FAIL] ", "1;31");
        }
        echo $label . ($details !== '' ? " - {$details}" : '') . "\n";
    };
    $warn = static function (string $label, string $details = '') use (&$warnings): void {
        $warnings++;
        printColor("[WARN] ", "1;33");
        echo $label . ($details !== '' ? " - {$details}" : '') . "\n";
    };

    $check('PHP runtime', version_compare(PHP_VERSION, '8.0.0', '>='), PHP_VERSION);

