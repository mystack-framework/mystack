define('ROOT_DIR', __DIR__);

// Read the command before bootstrapping. Framework audits and smoke tests need
// every library class; all other CLI commands stay lightweight and fast.
$bootstrapArgs = $argv;
array_shift($bootstrapArgs);
$bootstrapCommand = $bootstrapArgs[0] ?? null;
$runtimeCommandPrefixes = [
    'route:', 'config:', 'library:', 'ui:', 'phjs:', 'health:', 'db:', 'schema:',
    'queue:', 'schedule:', 'websocket:', 'mail:', 'oauth:', 'payment:', 'courier:',
    'phfy:', 'vapid:', 'logs:', 'monitor:', 'test:', 'build:', 'optimize',
];
$needsFrameworkRuntime = in_array($bootstrapCommand, ['audit', 'smoke', 'test'], true);
foreach ($runtimeCommandPrefixes as $runtimePrefix) {
    if (str_starts_with((string) $bootstrapCommand, $runtimePrefix)) {
        $needsFrameworkRuntime = true;
        break;
    }
}

$libraryPath = ROOT_DIR . '/library/library.php';
function ensureFrameworkRuntime(): void {
    static $booted = false;
    if ($booted) return;
    $path = ROOT_DIR . '/library/library.php';
    if (!is_file($path)) throw new RuntimeException('library/library.php not found. Are you in the project root?');
    require_once $path;
    if (class_exists('DIR') && method_exists('DIR', 'initialize')) DIR::initialize(['rootDir' => ROOT_DIR]);
    $booted = true;
}
if ($needsFrameworkRuntime) {
    try { ensureFrameworkRuntime(); }
    catch (Throwable $exception) {
        echo "\033[31m[!] Error: {$exception->getMessage()}\033[0m\n";
        exit(1);
    }
}

// Ensure necessary core directories exist
$appDir = ROOT_DIR . '/app';
$componentDir = ROOT_DIR . '/component';

// Adaptive terminal UI. JSON output remains plain and machine-readable.
final class MyStackTui {
    private static ?bool $color = null;

    public static function color(): bool {
        if (self::$color !== null) return self::$color;
        $disabled = getenv('NO_COLOR') !== false || in_array('--no-ansi', $_SERVER['argv'] ?? [], true);
        $interactive = function_exists('stream_isatty') ? @stream_isatty(STDOUT) : true;
        return self::$color = !$disabled && ($interactive || PHP_OS_FAMILY === 'Windows');
    }

    public static function paint(string $text, string $code): string {
        return self::color() ? "\033[{$code}m{$text}\033[0m" : $text;
    }

    public static function header(string $subtitle = 'Next-generation PHP application console'): void {
        $logo = [
            ' __  __ __   __ ____  _____  _    _____ _  __',
            '|  \\/  |\\ \\ / // ___||_   _|/ \\  /  ___| |/ /',
            '| |\\/| | \\ V / \\___ \\  | | / _ \\ | |   | \' / ',
            '| |  | |  | |   ___) | | |/ ___ \\| |___| . \\ ',
            '|_|  |_|  |_|  |____/  |_/_/   \\_\\_____|_|\\_\\',
        ];
        $colors = ['1;38;5;45', '1;38;5;39', '1;38;5;75', '1;38;5;111', '1;38;5;141'];
        echo "\n";
        foreach ($logo as $index => $line) echo self::paint('  ' . $line, $colors[$index]) . "\n";
        echo self::paint('  ***  M Y S T A C K     F R A M E W O R K  ***', '1;38;5;45') . "\n";
        echo self::paint('  ' . $subtitle, '2;37') . "\n";
        echo self::paint('  ' . str_repeat('─', 47), '2;38;5;45') . "\n";
    }

    public static function badge(string $label, string $message, string $color, string $symbol): void {
        echo '  ' . self::paint(" {$symbol} {$label} ", $color) . ' ' . $message . "\n";
    }

    public static function section(string $title): void {
        echo "\n  " . self::paint('◆ ' . $title, '1;38;5;45') . "\n";
    }

    public static function progress(int $current, int $total, string $label = ''): void {
        $total = max(1, $total); $current = max(0, min($current, $total));
        $width = 28; $filled = (int) floor(($current / $total) * $width);
        $bar = str_repeat('█', $filled) . str_repeat('░', $width - $filled);
        $percent = (int) round(($current / $total) * 100);
        echo "\r  " . self::paint($bar, '1;38;5;45') . sprintf(' %3d%%  %s', $percent, $label);
        if ($current >= $total) echo "\n";
    }

    public static function data(array $data, int $depth = 0): void {
        foreach ($data as $key => $value) {
            $indent = str_repeat('  ', $depth + 1);
            $label = is_int($key) ? '#' . ($key + 1) : str_replace('_', ' ', (string) $key);
            if (is_array($value)) {
                echo $indent . self::paint('› ' . $label, '1;38;5;117') . "\n";
                self::data($value, $depth + 1);
                continue;
            }
            if (is_bool($value)) $display = $value ? self::paint('YES', '1;32') : self::paint('NO', '1;31');
            elseif ($value === null) $display = self::paint('—', '2;37');
            else $display = (string) $value;
            echo $indent . self::paint(str_pad($label, 24), '38;5;250') . ' ' . $display . "\n";
        }
    }
}

function printColor($msg, $colorCode) { echo MyStackTui::paint((string) $msg, (string) $colorCode); }
function info($msg) { MyStackTui::badge('INFO', (string) $msg, '1;46;30', 'i'); }
function success($msg) { MyStackTui::badge('SUCCESS', (string) $msg, '1;42;30', '+'); }
function error($msg) { MyStackTui::badge('ERROR', (string) $msg, '1;41;97', 'x'); exit(1); }
function warning($msg) { MyStackTui::badge('WARNING', (string) $msg, '1;43;30', '!'); }

