            'make:command' => 'Command', 'make:api' => 'Api', 'make:service' => 'Service', 'make:job' => 'Job',
            'make:event' => 'Event', 'make:listener' => 'Listener', 'make:mail' => 'Mail',
            'make:notification' => 'Notification', 'make:policy' => 'Policy', 'make:test' => 'Test',
            'make:request' => 'Request', 'make:resource' => 'Resource', 'make:factory' => 'Factory',
            'make:migration' => 'Migration', 'make:seeder' => 'Seeder', default => '',
        };
        if (in_array($command, ['make:crud','make:module'], true)) return self::generateSet($command, $base, $options);
        $class = str_ends_with($base, $suffix) ? $base : $base . $suffix; $path = ROOT_DIR . '/app/' . $class . '.php';
        $content = self::generatorContent($command, $class, $base);
        generateFile($path, $content, $class); return 0;
    }

    private static function generatorContent(string $command, string $class, string $base): string {
        return match ($command) {
            'make:command' => "<?php\nfinal class {$class} {\n    public static function commandName(): string { return '" . strtolower(preg_replace('/(?<!^)[A-Z]/', ':$0', $base)) . "'; }\n    public static function description(): string { return 'Application command {$base}.'; }\n    public static function handle(array \$arguments, array \$options): int {\n        echo \"{$class} executed.\\n\";\n        return 0;\n    }\n}\n",
            'make:api' => "<?php\nfinal class {$class} {\n    public static function register(string \$path = '/api/" . strtolower($base) . "'): void {\n        PHAP::api('GET ' . \$path, false, [], fn() => ['resource' => '{$base}']);\n    }\n}\n",
            'make:service' => "<?php\nfinal class {$class} {\n    public static function run(array \$input = []): array { return ['status' => true, 'data' => \$input]; }\n}\n",
            'make:job' => "<?php\nfinal class {$class} {\n    public static function handle(array \$payload): void {\n        // Perform an idempotent background operation.\n    }\n}\n",
            'make:event' => "<?php\nfinal class {$class} {\n    public function __construct(public readonly array \$data = []) {}\n}\n",
            'make:listener' => "<?php\nfinal class {$class} {\n    public static function handle(object|array \$event): void {}\n}\n",
            'make:mail' => "<?php\nfinal class {$class} {\n    public static function send(string \$from, string \$to, string \$subject, string \$html, string \$sender = 'MyStack'): bool {\n        return (bool) PHEM::smtpSend(\$from, \$sender, \$to, '', '', \$subject, \$html);\n    }\n}\n",
            'make:notification' => "<?php\nfinal class {$class} {\n    public static function send(string \$message, array \$options = []): array { return PHFY::send(\$message, \$options); }\n}\n",
            'make:policy' => "<?php\nfinal class {$class} {\n    public static function allows(array \$identity, string \$ability, mixed \$resource = null): bool { return false; }\n}\n",
            'make:test' => "<?php\nfinal class {$class} {\n    public static function run(): array { return ['status' => true, 'assertions' => 1]; }\n}\n",
            'make:request' => "<?php\nfinal class {$class} {\n    public static function validate(array \$input): array {\n        return PHVD::check(['name' => 'required|string|max:255'], \$input);\n    }\n}\n",
            'make:resource' => "<?php\nfinal class {$class} {\n    public static function make(array \$row): array {\n        return ['id' => \$row['id'] ?? null, 'data' => \$row];\n    }\n}\n",
            'make:factory' => "<?php\nfinal class {$class} {\n    public static function make(array \$overrides = []): array {\n        return array_replace(['name' => '{$base}', 'created_at' => date('Y-m-d H:i:s')], \$overrides);\n    }\n}\n",
            'make:migration' => "<?php\nfinal class {$class} {\n    public static function up(): void {\n        // PHDB::createTable('" . MyStackBrain::tableName($base) . "', ['id' => 'BIGINT AUTO_INCREMENT PRIMARY KEY']);\n    }\n    public static function down(): void {\n        // PHDB::dropTable('" . MyStackBrain::tableName($base) . "');\n    }\n}\n",
            'make:seeder' => "<?php\nfinal class {$class} {\n    public static function run(): void {\n        // Keep seed operations repeatable when possible.\n    }\n}\n",
            default => throw new InvalidArgumentException("Unsupported generator: {$command}"),
        };
    }

    private static function generateSet(string $command, string $base, array $options): int {
        $definitions = $command === 'make:crud'
            ? [
                ROOT_DIR . "/app/{$base}Model.php" => "<?php\nfinal class {$base}Model {\n    private const TABLE = '" . MyStackBrain::tableName($base . 'Model') . "';\n    public static function all(): array { return PHDB::select(self::TABLE); }\n    public static function find(int|string \$id): ?array { return PHDB::find(self::TABLE, \$id); }\n    public static function create(array \$data): bool { return (bool) PHDB::insert(self::TABLE, \$data); }\n}\n",
                ROOT_DIR . "/app/{$base}Controller.php" => "<?php\nfinal class {$base}Controller { public static function index(): array { return PHDB::select('" . MyStackBrain::tableName($base . 'Model') . "'); } }\n",
                ROOT_DIR . "/app/{$base}Api.php" => self::generatorContent('make:api', "{$base}Api", $base),
                ROOT_DIR . "/component/{$base}View.php" => "<?php echo PHUI::section('section:hero', ['hero_title' => '{$base}', 'hero_desc' => 'Resource overview']);\n",
            ] : [
                ROOT_DIR . "/app/{$base}Service.php" => self::generatorContent('make:service', "{$base}Service", $base),
                ROOT_DIR . "/app/{$base}Api.php" => self::generatorContent('make:api', "{$base}Api", $base),
                ROOT_DIR . "/component/{$base}View.php" => "<?php echo PHUI::section('section:hero', ['hero_title' => '{$base}', 'hero_desc' => 'Module view']);\n",
            ];
        foreach (array_keys($definitions) as $path) if (file_exists($path)) throw new RuntimeException('Generation stopped; file already exists: ' . $path);
        $created = [];
        try { foreach ($definitions as $path => $content) { if (file_put_contents($path, $content, LOCK_EX) === false) throw new RuntimeException('Could not create: ' . $path); $created[] = $path; } }
        catch (Throwable $error) { foreach ($created as $path) @unlink($path); throw $error; }
        self::emit(['status' => true, 'created' => $created], $options); return 0;
    }

    private static function customCommands(): array {
        ensureFrameworkRuntime();
        static $commands = null; if (is_array($commands)) return $commands; $commands = [];
        foreach (glob(ROOT_DIR . '/app/*Command.php') ?: [] as $file) {
            $definition = self::parseCommandFile($file);
            if ($definition !== null) $commands[$definition['name']] = $definition;
        }
        ksort($commands);
        return $commands;
    }

    /**
     * Discovers an application command from source tokens only, without executing
     * any application code during help, list, doctor, audit or dispatch lookup.
     */
    private static function parseCommandFile(string $file): ?array {
        $source = (string) @file_get_contents($file);
        if ($source === '' || !str_contains($source, 'commandName')) return null;
        $tokens = @token_get_all($source);
        if (!is_array($tokens)) return null;
        $namespace = ''; $class = null; $name = null; $description = null; $hasHandle = false;
        $count = count($tokens);
        for ($i = 0; $i < $count; $i++) {
            $token = $tokens[$i];
            if (is_array($token) && $token[0] === T_NAMESPACE) {
                for ($j = $i + 1; $j < $count; $j++) {
                    $part = $tokens[$j];
                    if (is_array($part) && ($part[0] === T_STRING || $part[0] === T_NAME_QUALIFIED)) $namespace .= $part[1];
                    elseif ($part === ';' || $part === '{') break;
                }
                continue;
            }
            if ($class === null && is_array($token) && $token[0] === T_CLASS) {
                for ($j = $i + 1; $j < $count; $j++) {
                    if (is_array($tokens[$j]) && $tokens[$j][0] === T_STRING) { $class = $tokens[$j][1]; break; }
                    if ($tokens[$j] === '{') break;
                }
                continue;
            }
            if (!is_array($token) || $token[0] !== T_FUNCTION) continue;
            $method = null;
            for ($j = $i + 1; $j < $count; $j++) {
                if (is_array($tokens[$j]) && $tokens[$j][0] === T_STRING) { $method = $tokens[$j][1]; break; }
                if (!(is_array($tokens[$j]) && $tokens[$j][0] === T_WHITESPACE)) break;
            }
            if ($method === 'handle') $hasHandle = true;
            elseif ($method === 'commandName') $name = self::firstReturnLiteral($tokens, $i, $count);
            elseif ($method === 'description') $description = self::firstReturnLiteral($tokens, $i, $count);
        }
        if ($class === null || $name === null || !$hasHandle) return null;
        if (!preg_match('/^[a-z][a-z0-9:_-]*$/', $name)) return null;
        return [
            'name' => $name,
            'class' => ($namespace !== '' ? $namespace . '\\' : '') . $class,
            'description' => is_string($description) && $description !== '' ? $description : 'Application command.',
            'file' => $file,
        ];
    }

    private static function firstReturnLiteral(array $tokens, int $functionIndex, int $count): ?string {
        $depth = 0; $inBody = false;
        for ($j = $functionIndex + 1; $j < $count; $j++) {
            $token = $tokens[$j];
            if ($token === '{') { $depth++; $inBody = true; continue; }
            if ($token === '}') { $depth--; if ($inBody && $depth === 0) break; continue; }
            if (!$inBody || !is_array($token) || $token[0] !== T_RETURN) continue;
            for ($k = $j + 1; $k < $count; $k++) {
                $value = $tokens[$k];
                if (is_array($value) && $value[0] === T_CONSTANT_ENCAPSED_STRING) {
                    $literal = substr((string) $value[1], 1, -1);
                    return str_starts_with((string) $value[1], '"') ? stripcslashes($literal) : str_replace(["\\'", '\\\\'], ["'", '\\'], $literal);
                }
                if (is_array($value) && in_array($value[0], [T_WHITESPACE, T_COMMENT, T_DOC_COMMENT], true)) continue;
                return null;
            }
        }
        return null;
    }

    private static function customCommand(string $command): ?array { return self::customCommands()[$command] ?? null; }
    private static function runCustom(string $command, array $args, array $options): int {
        $definition = self::customCommand($command); if ($definition === null) return 1;
        if (!class_exists($definition['class'], false) && is_file($definition['file'])) require_once $definition['file'];
        if (!class_exists($definition['class']) || !method_exists($definition['class'], 'handle')) {
            error("Application command '{$command}' could not be loaded from {$definition['file']}.");
        }
        $result = $definition['class']::handle($args, $options); return is_int($result) ? $result : 0;
    }
}

/** Durable, local single-server queue and scheduler used by the console kernel. */
final class MyStackQueueScheduler {
    private static ?PDO $pdo = null;

    private static function db(): PDO {
        if (self::$pdo instanceof PDO) return self::$pdo;
        $directory = ROOT_DIR . '/.mystack'; if (!is_dir($directory) && !mkdir($directory, 0775, true) && !is_dir($directory)) throw new RuntimeException('Unable to create .mystack.');
        $pdo = new PDO('sqlite:' . $directory . '/console.sqlite', null, null, [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION, PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC]);
        $pdo->exec('PRAGMA journal_mode=WAL; PRAGMA busy_timeout=5000; PRAGMA synchronous=NORMAL');
        $pdo->exec('CREATE TABLE IF NOT EXISTS jobs (id INTEGER PRIMARY KEY AUTOINCREMENT, job TEXT NOT NULL, payload TEXT NOT NULL, status TEXT NOT NULL DEFAULT "pending", attempts INTEGER NOT NULL DEFAULT 0, max_attempts INTEGER NOT NULL DEFAULT 3, available_at INTEGER NOT NULL, reserved_at INTEGER, completed_at INTEGER, error TEXT, created_at INTEGER NOT NULL)');
        $pdo->exec('CREATE INDEX IF NOT EXISTS jobs_status_available ON jobs(status, available_at)');
        $pdo->exec('CREATE TABLE IF NOT EXISTS schedules (name TEXT PRIMARY KEY, expression TEXT NOT NULL, command TEXT NOT NULL, enabled INTEGER NOT NULL DEFAULT 1, last_run INTEGER, created_at INTEGER NOT NULL)');
        $pdo->exec('CREATE TABLE IF NOT EXISTS migrations (name TEXT PRIMARY KEY, batch INTEGER NOT NULL, applied_at INTEGER NOT NULL)');
        self::$pdo = $pdo; return $pdo;
    }

    public static function push(array $args, array $options): int {
        $job = trim((string) ($args[0] ?? ''));
        if (!preg_match('/^[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)*$/', $job)) {
            throw new InvalidArgumentException('A valid job class is required.');
        }
        $payload = json_decode((string) ($options['payload'] ?? '{}'), true); if (!is_array($payload)) throw new InvalidArgumentException('--payload must be a JSON object.');
        $delay = max(0, (int) ($options['delay'] ?? 0)); $tries = max(1, min(100, (int) ($options['tries'] ?? 3)));
        $statement = self::db()->prepare('INSERT INTO jobs(job,payload,max_attempts,available_at,created_at) VALUES(?,?,?,?,?)'); $statement->execute([$job, json_encode($payload, JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE), $tries, time() + $delay, time()]);
        self::output(['status' => true, 'id' => (int) self::db()->lastInsertId(), 'job' => $job], $options); return 0;
    }

    public static function counts(): array {
        $rows = self::db()->query('SELECT status, COUNT(*) total FROM jobs GROUP BY status')->fetchAll(); $counts = ['pending'=>0,'running'=>0,'completed'=>0,'failed'=>0];
        foreach ($rows as $row) $counts[$row['status']] = (int) $row['total']; return $counts;
    }

    public static function status(array $options): int { self::output(['queue' => self::counts()], $options); return 0; }

    public static function work(array $options): int {
        $daemon = !empty($options['daemon']); $limit = max(1, min(1000, (int) ($options['limit'] ?? ($daemon ? 1000 : 1)))); $processed = 0; $sleep = max(1, min(60, (int) ($options['sleep'] ?? 2)));
        $reclaimed = self::reclaimStale(max(60, (int) ($options['timeout'] ?? 900)));
        do {
            $job = self::reserve();
            if ($job === null) { if ($daemon) { sleep($sleep); continue; } break; }
            self::execute($job); $processed++;
            if (!$daemon && $processed >= $limit) break;
        } while (true);
        self::output(['status' => true, 'processed' => $processed, 'reclaimed' => $reclaimed, 'queue' => self::counts()], $options); return 0;
    }

    public static function reclaimStale(int $timeoutSeconds = 900): int {
        $statement = self::db()->prepare('UPDATE jobs SET status="pending", available_at=?, error=? WHERE status="running" AND reserved_at>0 AND reserved_at < ?');
        $statement->execute([time(), "Reclaimed: reserved longer than {$timeoutSeconds}s", time() - $timeoutSeconds]);
        return $statement->rowCount();
    }

    private static function reserve(): ?array {
        $pdo = self::db(); $pdo->exec('BEGIN IMMEDIATE');
        try {
            $statement = $pdo->prepare('SELECT * FROM jobs WHERE status="pending" AND available_at<=? ORDER BY id LIMIT 1'); $statement->execute([time()]); $job = $statement->fetch();
            if (!$job) { $pdo->exec('COMMIT'); return null; }
            $update = $pdo->prepare('UPDATE jobs SET status="running", reserved_at=?, attempts=attempts+1 WHERE id=? AND status="pending"'); $update->execute([time(), $job['id']]);
            $pdo->exec('COMMIT'); return $update->rowCount() === 1 ? $job : null;
        } catch (Throwable $error) {
            try { $pdo->exec('ROLLBACK'); } catch (Throwable) {}
            throw $error;
        }
    }

    private static function execute(array $job): void {
        $class = (string) $job['job']; $file = ROOT_DIR . '/app/' . basename(str_replace('\\', '/', $class)) . '.php';
        try {
            if (!class_exists($class, false) && is_file($file)) require_once $file;
            if (!class_exists($class) || !method_exists($class, 'handle')) throw new RuntimeException("Job class {$class}::handle() is unavailable.");
            $payload = json_decode($job['payload'], true, 512, JSON_THROW_ON_ERROR); $class::handle($payload);
            $statement = self::db()->prepare('UPDATE jobs SET status="completed", completed_at=?, error=NULL WHERE id=?'); $statement->execute([time(), $job['id']]);
        } catch (Throwable $error) {
            $attempt = (int) $job['attempts'] + 1; $failed = $attempt >= (int) $job['max_attempts'];
            $statement = self::db()->prepare('UPDATE jobs SET status=?, available_at=?, reserved_at=NULL, error=? WHERE id=?'); $statement->execute([$failed ? 'failed' : 'pending', time() + min(300, 2 ** min(8, $attempt)), substr($error->getMessage(), 0, 2000), $job['id']]);
        }
    }

    public static function failed(array $options): int { $rows = self::db()->query('SELECT id,job,attempts,error,created_at FROM jobs WHERE status="failed" ORDER BY id DESC LIMIT 500')->fetchAll(); self::output(['count'=>count($rows),'jobs'=>$rows],$options); return 0; }
    public static function retry(array $args, array $options): int { $target = (string) ($args[0] ?? ''); if ($target === 'all') $count = self::db()->exec('UPDATE jobs SET status="pending", attempts=0, error=NULL, available_at=' . time() . ' WHERE status="failed"'); elseif (ctype_digit($target)) { $s=self::db()->prepare('UPDATE jobs SET status="pending", attempts=0, error=NULL, available_at=? WHERE id=? AND status="failed"');$s->execute([time(),(int)$target]);$count=$s->rowCount(); } else throw new InvalidArgumentException('Use a failed job ID or all.'); self::output(['retried'=>$count],$options); return $count>0?0:1; }
    public static function forget(array $args, array $options): int { $id=(string)($args[0]??'');if(!ctype_digit($id))throw new InvalidArgumentException('A numeric failed job ID is required.');if(!MyStackConsoleKernel::confirm("Delete failed job #{$id}?",$options))return 0;$s=self::db()->prepare('DELETE FROM jobs WHERE id=? AND status="failed"');$s->execute([(int)$id]);self::output(['deleted'=>$s->rowCount()],$options);return $s->rowCount()?0:1; }
    public static function flush(array $options): int { if(!MyStackConsoleKernel::confirm('Delete all completed and failed queue records?',$options))return 0;$count=self::db()->exec('DELETE FROM jobs WHERE status IN ("completed","failed")');self::output(['deleted'=>$count],$options);return 0; }

    private static function migrationFiles(): array {
        $files = glob(ROOT_DIR . '/app/*Migration.php') ?: [];
        usort($files, static fn(string $a, string $b): int => strnatcasecmp(basename($a), basename($b)));
        return $files;
    }

    private static function migrationClass(string $file): string {
        return pathinfo($file, PATHINFO_FILENAME);
    }

    private static function requireDatabase(): void {
        if (!MyStackConsoleKernel::configureDatabase()) throw new RuntimeException('Literal PHDB configuration was not found in index.php.');
        $check = PHDB::checker();
        if (empty($check['status'])) throw new RuntimeException('Database is not ready: ' . ($check['error'] ?? 'connection failed'));
    }

    public static function migrationStatus(array $options): int {
        $applied = [];
        foreach (self::db()->query('SELECT name,batch,applied_at FROM migrations ORDER BY batch,name')->fetchAll() as $row) $applied[$row['name']] = $row;
        $rows = [];
        foreach (self::migrationFiles() as $file) {
            $name = self::migrationClass($file);
            $rows[] = ['name' => $name, 'status' => isset($applied[$name]) ? 'applied' : 'pending', 'batch' => $applied[$name]['batch'] ?? null, 'file' => $file];
        }
        self::output(['count' => count($rows), 'migrations' => $rows], $options);
        return 0;
    }

    public static function migrate(array $options): int {
        self::requireDatabase();
        $applied = self::db()->query('SELECT name FROM migrations')->fetchAll(PDO::FETCH_COLUMN);
        $known = array_fill_keys(array_map('strval', $applied), true);
        $batch = (int) self::db()->query('SELECT COALESCE(MAX(batch),0)+1 FROM migrations')->fetchColumn();
        $ran = [];
        foreach (self::migrationFiles() as $file) {
            $class = self::migrationClass($file);
            if (isset($known[$class])) continue;
            require_once $file;
            if (!class_exists($class) || !is_callable([$class, 'up'])) throw new RuntimeException("Migration {$class} must provide public static up().");
            $class::up();
            $statement = self::db()->prepare('INSERT INTO migrations(name,batch,applied_at) VALUES(?,?,?)');
            $statement->execute([$class, $batch, time()]);
            $ran[] = $class;
        }
        self::output(['status' => true, 'batch' => $ran === [] ? null : $batch, 'ran' => $ran], $options);
        return 0;
    }

    public static function migrationRollback(array $options): int {
        $steps = max(1, min(100, (int) ($options['step'] ?? 1)));
        if (!MyStackConsoleKernel::confirm("Roll back the latest {$steps} migration batch(es)?", $options)) return 0;
        self::requireDatabase();
        $batches = self::db()->query('SELECT DISTINCT batch FROM migrations ORDER BY batch DESC LIMIT ' . $steps)->fetchAll(PDO::FETCH_COLUMN);
        if ($batches === []) { self::output(['status' => true, 'rolled_back' => []], $options); return 0; }
        $placeholders = implode(',', array_fill(0, count($batches), '?'));
        $statement = self::db()->prepare("SELECT name,batch FROM migrations WHERE batch IN ({$placeholders}) ORDER BY batch DESC, applied_at DESC, name DESC");
        $statement->execute($batches); $rolledBack = [];
        foreach ($statement->fetchAll() as $row) {
            $class = (string) $row['name']; $file = ROOT_DIR . '/app/' . $class . '.php';
            if (is_file($file)) require_once $file;
            if (!class_exists($class) || !is_callable([$class, 'down'])) throw new RuntimeException("Migration {$class} must provide public static down().");
            $class::down();
            $delete = self::db()->prepare('DELETE FROM migrations WHERE name=?'); $delete->execute([$class]);
            $rolledBack[] = $class;
        }
        self::output(['status' => true, 'rolled_back' => $rolledBack], $options);
        return 0;
    }

    public static function seed(array $args, array $options): int {
        self::requireDatabase();
        $target = trim((string) ($args[0] ?? 'all')); $files = glob(ROOT_DIR . '/app/*Seeder.php') ?: [];
        $ran = [];
        foreach ($files as $file) {
            $class = pathinfo($file, PATHINFO_FILENAME);
            if ($target !== 'all' && strcasecmp($target, $class) !== 0 && strcasecmp($target . 'Seeder', $class) !== 0) continue;
            require_once $file;
            if (!class_exists($class) || !is_callable([$class, 'run'])) throw new RuntimeException("Seeder {$class} must provide public static run().");
            $class::run(); $ran[] = $class;
        }
        if ($target !== 'all' && $ran === []) throw new RuntimeException("Seeder {$target} was not found.");
        self::output(['status' => true, 'ran' => $ran], $options); return 0;
    }

    public static function scheduleAdd(array $args, array $options): int {
        $name=trim((string)($args[0]??''));$expression=trim((string)($args[1]??''));$command=trim(implode(' ', array_map(static function ($argument): string {
            $argument = (string) $argument;
