        && str_contains(PHJS::appOAuthStart('/oauth/google'), 'APP.auth.oauth.start')
        && str_contains(PHJS::appTwoFactorSubmit('/2fa', 'code'), 'APP.auth.twoFactor.submit')
        && str_contains(PHJS::appPaymentStart('/payment'), 'APP.payment.start');
    $check(
        'PHJS secure OAuth / 2FA / hosted-payment bridge',
        $secureFlowHelpers,
        'same-origin actions, CSRF, timeout, idempotency, replay-safe UX'
    );

    $phroSource = is_file(ROOT_DIR . '/library/PHRO.php')
        ? file_get_contents(ROOT_DIR . '/library/PHRO.php')
        : false;
    $canonicalPhjsSource = is_file($phpPair[0]) ? file_get_contents($phpPair[0]) : false;
    $identityBridgeValid = is_string($secureFlowSource)
        && is_string($canonicalPhjsSource)
        && is_string($phroSource)
        && str_contains($canonicalPhjsSource, "PHCO::path()")
        && str_contains($canonicalPhjsSource, "PHCO::pre()")
        && str_contains($canonicalPhjsSource, 'projectPrefix:detectedProjectPrefix')
        && str_contains($secureFlowSource, '_persistIdentity("hash",fp)')
        && str_contains($secureFlowSource, '_persistIdentity("key",networkKey)')
        && str_contains($secureFlowSource, '"X-Device-Fingerprint":this.fingerprint||""')
        && str_contains($secureFlowSource, 'networkInfoEndpoint:detectedBasePath+"_phjs/network-info"')
        && !str_contains($secureFlowSource, 'json.geoiplookup.io')
        && !str_contains($secureFlowSource, 'freeipapi.com')
        && !str_contains($secureFlowSource, 'ip-api.io')
        && str_contains($phroSource, 'self::get("/_phjs/network-info"')
        && str_contains($phroSource, "'key' => \$footprint['clientXNetkey']")
        && str_contains($phroSource, "'hosting' => (bool)");
    $check(
        'PHJS device/network identity bridge',
        $identityBridgeValid,
        'PHP-injected base/prefix, stable hash/key cookies, same-origin network lookup, VPN/proxy signals'
    );

    $phjsUtf8Valid = true;
    foreach (array_merge($phpPair, $jsPair) as $phjsBuild) {
        $phjsSource = is_file($phjsBuild) ? file_get_contents($phjsBuild) : false;
        if (
            $phjsSource === false
            || !preg_match('//u', $phjsSource)
            || str_starts_with($phjsSource, "\xEF\xBB\xBF")
            || str_contains($phjsSource, "\u{FFFD}")
            || preg_match('/(?:à¦|à§|Ã°|Ãƒ|â€|ï¿½)/u', $phjsSource)
            || !str_contains($phjsSource, 'সংরক্ষণ করুন')
        ) {
            $phjsUtf8Valid = false;
            break;
        }
    }
    $check('PHJS UTF-8 and Bengali text integrity', $phjsUtf8Valid);

    $premiumUiSource = is_file($jsPair[0]) ? file_get_contents($jsPair[0]) : false;
    $premiumUiSystems = [
        'APP.navigation=',
        'APP.commerce=',
        'APP.dataTable=',
        'APP.dashboard=',
        'APP.controls=',
        'APP.fileManager=',
        'APP.richText=',
        'APP.kanban=',
        'APP.calendar=',
        'APP.workflow=',
        'APP.virtualList=',
        'APP.carousel=',
        'APP.tree=',
        'APP.timeline=',
        'APP.splitPane=',
        'APP.tour=',
        'APP.signature=',
        'APP.premium=',
    ];
    $premiumUiValid = is_string($premiumUiSource);
    foreach ($premiumUiSystems as $premiumUiSystem) {
        if (!$premiumUiValid || !str_contains($premiumUiSource, $premiumUiSystem)) {
            $premiumUiValid = false;
            break;
        }
    }
    $check('PHJS premium UI systems - ' . count($premiumUiSystems) . ' modules', $premiumUiValid);

    $swSource = ROOT_DIR . '/src/js/SW.php';
    $swBuild = ROOT_DIR . '/src/js/sw.js';
    $swMatches = false;
    if (is_file($swSource) && is_file($swBuild)) {
        ob_start();
        include $swSource;
        $renderedWorker = ob_get_clean();
        $swMatches = is_string($renderedWorker)
            && hash('sha256', str_replace(["\r\n", "\r"], "\n", $renderedWorker))
                === hash('sha256', str_replace(["\r\n", "\r"], "\n", (string) file_get_contents($swBuild)));
    }
    $check('Service Worker synchronized build', $swMatches);

    foreach (['css', 'js', 'php'] as $section) {
        $directory = ROOT_DIR . '/src/cache/' . $section;
        $check("Cache directory: {$section}", is_dir($directory) && is_writable($directory));
    }

    $folderState = $GLOBALS['folderMapReport']
        ?? MyStackBrain::ensureFolderMap(ROOT_DIR, false);
    $check(
        'Framework canonical folder map',
        !empty($folderState['status']) && MyStackBrain::testFolderMapEngine(),
        ($folderState['ready'] ?? 0) . '/' . ($folderState['total'] ?? 0) . ' ready, auto-repair verified'
    );

    $updatePolicy = MyStackUpdater::policy();
    $updaterSource = (string) file_get_contents(ROOT_DIR . '/mystack');
    $check(
        'MyStack secure main-branch updater',
        ($updatePolicy['repository'] ?? '') === 'mystack-framework/mystack'
            && ($updatePolicy['branch'] ?? '') === 'main'
            && ($updatePolicy['hash'] ?? '') === 'sha256'
            && ($updatePolicy['deletes_local_files'] ?? true) === false
            && in_array('library/*', $updatePolicy['paths'] ?? [], true)
            && in_array('src/js/*', $updatePolicy['paths'] ?? [], true)
            && count($updatePolicy['root_files'] ?? []) === 5
            && MyStackBrain::suggestCommand('updat') === 'update'
            && str_contains($updaterSource, 'codeload.github.com/')
            && str_contains($updaterSource, 'ZipArchive')
            && str_contains($updaterSource, 'Post-update verification failed; every changed file was rolled back.')
            && str_contains($updaterSource, 'CURLOPT_SSL_VERIFYPEER')
            && str_contains($updaterSource, "'--proto', '=https'"),
        'SHA-256/byte diff, strict allowlist, confirmation, staging, smoke and rollback'
    );

    $documentationFiles = ['README.md', 'MANUAL_BN.md', 'AGENTS.md', 'LICENSE'];
    $documentation = [];
    $documentationHealthy = true;
    foreach ($documentationFiles as $documentationFile) {
        $contents = @file_get_contents(ROOT_DIR . '/' . $documentationFile);
        if (!is_string($contents) || $contents === '' || preg_match('//u', $contents) !== 1) {
            $documentationHealthy = false;
            continue;
        }
        $documentation[$documentationFile] = $contents;
        if (str_contains($contents, 'à¦') || str_contains($contents, "\u{FFFD}")) {
            $documentationHealthy = false;
        }
        if ($documentationFile !== 'LICENSE' && substr_count($contents, '```') % 2 !== 0) {
            $documentationHealthy = false;
        }
    }
    $manualLibraries = [
        'PHAI', 'PHAP', 'PHAU', 'PHCD', 'PHCO', 'PHCS', 'PHDB', 'PHDE', 'PHED', 'PHEM',
        'PHEV', 'PHFY', 'PHJC', 'PHJS', 'PHJT', 'PHLS', 'PHML', 'PHMO', 'PHOB', 'PHOP',
        'PHPA', 'PHQR', 'PHRO', 'PHRQ', 'PHSE', 'PHTM', 'PHTP', 'PHTR', 'PHUI', 'PHVD',
    ];
    $manual = $documentation['MANUAL_BN.md'] ?? '';
    foreach ($manualLibraries as $manualLibrary) {
        if (!str_contains($manual, '`' . $manualLibrary . '`') && !str_contains($manual, $manualLibrary . ':')) {
            $documentationHealthy = false;
            break;
        }
    }
    $readme = $documentation['README.md'] ?? '';
    $agents = $documentation['AGENTS.md'] ?? '';
    $license = $documentation['LICENSE'] ?? '';
    $documentationHealthy = $documentationHealthy
        && strlen($readme) > 8000
        && strlen($manual) > 30000
        && strlen($agents) > 12000
        && str_contains($readme, 'MyStack does not automatically depend on `.env`, `APP_ENV`, or `APP_DEBUG`')
        && str_contains($manual, 'src/js/PHJS-min.php')
        && str_contains($manual, 'php mystack update --check')
        && str_contains($agents, 'PHJS is self-contained')
        && !str_contains($agents, 'Frontend reactivity relies on `src/js/phjs.js` and Alpine/HTMX')
        && str_contains($license, 'MIT License')
        && str_contains($license, 'THE SOFTWARE IS PROVIDED "AS IS"');
    $check(
        'Framework documentation integrity',
        $documentationHealthy,
        'UTF-8, balanced examples, 30-library catalog, current PHJS/config/CLI guidance and MIT text'
    );

    $intelligence = MyStackBrain::analyze(
        ROOT_DIR,
        $GLOBALS['appDir'],
        $GLOBALS['componentDir']
    );
    $check(
        'Project intelligence graph',
        ($intelligence['stats']['files'] ?? 0) > 0
            && MyStackBrain::smartName('user-profile') === 'UserProfile'
            && MyStackBrain::tableName('UserProfileModel') === 'user_profiles'
            && MyStackBrain::suggestCommand('doctro') === 'doctor',
        ($intelligence['stats']['routes'] ?? 0) . ' routes, '
            . ($intelligence['stats']['classes'] ?? 0) . ' classes, '
            . ($intelligence['stats']['imports'] ?? 0) . ' imports'
    );
    $check(
        'Route/class collision reasoning',
        !empty($intelligence['status']),
        ($intelligence['counts']['critical'] ?? 0) . ' critical conflict(s)'
    );
    foreach ($intelligence['issues'] as $insight) {
        if ($insight['severity'] === 'advice') {
            $warn(
                'Intelligence advice: ' . $insight['type'],
                $insight['message'] . ' (' . $insight['location'] . ')'
            );
        }
    }

    echo "\n";
    printColor(" {$reportTitle} Report \n", "1;44;97");
    echo "  Passed: {$passed}\n";
    echo "  Failed: {$failed}\n";
    echo "  Warnings: {$warnings}\n\n";

    return $failed === 0;
}

/**
 * Full framework smoke test. This intentionally reuses the comprehensive,
 * read-only audit suite so every smoke run exercises the same production
 * contracts without mutating application data or configuration.
 */
function runSmokeTests(): bool {
    return runFrameworkAudit('MyStack Full Smoke Test');
}

$args = $argv;
array_shift($args); // remove script name
$command = array_shift($args);
$name = $args[0] ?? null;

if (!$command || $command === 'help' || $command === '--help' || $command === '-h') {
    showHelp();
    exit(0);
}

// Context-aware name formatting is applied only to generator commands.
$cleanName = '';
if (str_starts_with((string) $command, 'make:') && $name !== null) {
    try {
        $cleanName = MyStackBrain::smartName((string) $name);
    } catch (InvalidArgumentException $exception) {
        error($exception->getMessage());
    }
}

$generatedClassSuffixes = [
    'make:controller' => 'Controller',
    'make:model' => 'Model',
    'make:middleware' => 'Middleware',
];
if ($cleanName !== '' && isset($generatedClassSuffixes[$command])) {
    $suffix = $generatedClassSuffixes[$command];
    $candidateClass = str_ends_with($cleanName, $suffix) ? $cleanName : $cleanName . $suffix;
    $preflight = MyStackBrain::analyze(ROOT_DIR, $appDir, $componentDir);
    if (isset($preflight['classes'][$candidateClass])) {
        error(
            "Generation blocked: class {$candidateClass} already exists in "
            . implode(', ', $preflight['classes'][$candidateClass])
        );
    }
}

switch ($command) {
    case 'make:controller':
        if (!$name) error("Controller name is required. Example: php mystack make:controller User");
        $className = str_ends_with($cleanName, 'Controller') ? $cleanName : $cleanName . 'Controller';
        $path = $appDir . '/' . $className . '.php';
        
        $content = "<?php\n/**\n * $className\n * Context-aware MyStack controller.\n */\nclass {$className} {\n\n    public function index(): array {\n        return ['status' => true, 'data' => PHDB::select('users')];\n    }\n\n    public function store(array \$request): array {\n        \$name = trim((string) (\$request['name'] ?? ''));\n        if (\$name === '') return ['status' => false, 'message' => 'Name is required.'];\n        \$saved = PHDB::insert('users', ['name' => \$name]);\n        return ['status' => (bool) \$saved, 'id' => PHDB::id()];\n    }\n\n    public function show(int \$id): array {\n        \$rows = PHDB::select('users', '*', ['id' => \$id], 1);\n        return ['status' => !empty(\$rows), 'data' => \$rows[0] ?? null];\n    }\n}\n";
        generateFile($path, $content, 'Controller');
        break;

    case 'make:model':
        if (!$name) error("Model name is required. Example: php mystack make:model Product");
        $className = str_ends_with($cleanName, 'Model') ? $cleanName : $cleanName . 'Model';
        $tableName = MyStackBrain::tableName($className);
        $path = $appDir . '/' . $className . '.php';
        
        $content = "<?php\n/**\n * $className\n * Context-aware MyStack model.\n */\nclass {$className} {\n    protected static string \$table = '{$tableName}';\n\n    public static function all(): array {\n        return PHDB::select(self::\$table);\n    }\n\n    public static function stream(array \$where = []): Generator {\n        return PHDB::fast(self::\$table, \$where);\n    }\n\n    public static function find(int \$id): ?array {\n        \$rows = PHDB::select(self::\$table, '*', ['id' => \$id], 1);\n        return \$rows[0] ?? null;\n    }\n\n    public static function create(array \$data): bool {\n        return (bool) PHDB::insert(self::\$table, \$data);\n    }\n}\n";
        generateFile($path, $content, 'Model');
        break;

    case 'make:middleware':
        if (!$name) error("Middleware name is required. Example: php mystack make:middleware Auth");
        $className = str_ends_with($cleanName, 'Middleware') ? $cleanName : $cleanName . 'Middleware';
        $path = $appDir . '/' . $className . '.php';
        
        $content = "<?php\n/**\n * $className\n * Auto-generated by MyStack CLI\n */\nclass {$className} {\n    public static function handle(\$request, \$next) {\n        // Demo Auth Logic:\n        // if (!isset(\$_SESSION['user'])) { return ['error' => 'Unauthorized']; }\n\n        return \$next(\$request);\n    }\n}\n";
        generateFile($path, $content, 'Middleware');
        break;

    case 'make:component':
        if (!$name) error("Component name is required. Example: php mystack make:component Alert");
        $className = str_ends_with($cleanName, 'Component') ? $cleanName : $cleanName . 'Component';
        $path = $componentDir . '/' . $className . '.php';
        
        $content = "<?php\n/**\n * Component: $className\n * Native PHUI component; import with import('component:$className').\n */\n\$title = (string) (\$data['title'] ?? 'Component Title');\n\$text = (string) (\$data['text'] ?? 'Component description goes here.');\n\$class = (string) (\$data['class'] ?? '');\n\$body = PHUI::ui('html:h3', [\n    'class' => 'text-xl font-bold text-foreground',\n    'text' => \$title,\n]);\n\$body .= PHUI::ui('html:p', [\n    'class' => 'text-muted-foreground mt-2',\n    'text' => \$text,\n]);\necho PHUI::ui('html:div', [\n    'class' => trim('bg-card p-6 rounded-2xl shadow-sm border border-border ' . \$class),\n    'slot' => \$body,\n]);\n";
        generateFile($path, $content, 'UI Component');
        break;

    case 'make:view':
        if (!$name) error("View name is required. Example: php mystack make:view Dashboard");
        $className = str_ends_with($cleanName, 'View') ? $cleanName : $cleanName . 'View';
        $path = $componentDir . '/' . $className . '.php';
        
        $content = "<?php\n/**\n * View: $className\n * Auto-generated page layout by MyStack CLI.\n */\n?>\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title><?= \$page_title ?? '{$cleanName}' ?></title>\n    <!-- CSS & JS injected by PHCS/PHJS automatically -->\n</head>\n<body class=\"bg-background text-foreground\">\n\n    <!-- Auto Header -->\n    <?= class_exists('PHUI') ? PHUI::ui('header:center', ['header_brand' => 'MyStack', 'header_items' => ['Home', 'About'], 'header_button' => ['label' => 'Login']]) : '<header>Header</header>' ?>\n\n    <main class=\"container mx-auto px-4 py-12\">\n        <h1 class=\"text-4xl font-extrabold mb-8\">Welcome to <?= \$page_title ?? '{$cleanName}' ?></h1>\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            <!-- Demo PHUI Component Usage -->\n            <?= class_exists('PHUI') ? PHUI::ui('section:feature-1', ['section_title' => 'Features', 'feature_items' => ['Fast', 'Secure', 'Native']]) : '<div>Content</div>' ?>\n        </div>\n    </main>\n\n    <!-- Auto Footer -->\n    <?= class_exists('PHUI') ? PHUI::ui('footer:simple', ['footer_copyright' => '&copy; 2024 MyStack']) : '<footer>Footer</footer>' ?>\n\n</body>\n</html>\n";
        generateFile($path, $content, 'View');
        break;

        case "get:started":
        info("Generating getting started demo code...");
        
        // 1. Create a demo route in app/
        $routePath = $appDir . "/WelcomeController.php";
        $viewPath = $componentDir . "/welcome.php";
        if (file_exists($routePath) || file_exists($viewPath)) {
            error('Getting-started generation stopped: WelcomeController.php or welcome.php already exists.');
        }
        $routeContent = "<?php
class WelcomeController {
    public static function index() {
        return import(\"component:welcome\");
    }
}

PHRO::get(\"/\", [WelcomeController::class, \"index\"]);
";
        generateFile($routePath, $routeContent, "Demo Controller");

        // 2. Create a demo view in component/
        $viewContent = "<?php
/**
 * View: Welcome
 */
?>
<!DOCTYPE html>
<html lang=\"en\">
<head>
    <meta charset=\"UTF-8\">
    <title>Welcome to Mystack</title>
</head>
<body class=\"bg-slate-50 text-slate-800\">
    <?= PHUI::ui(\"header:center\", [\"header_brand\" => \"MyStack\", \"header_items\" => [\"Home\", \"Features\", \"Docs\"], \"header_button\" => [\"label\" => \"Get Started\"]]) ?>
    <main class=\"container mx-auto mt-20 px-4 text-center\">
        <h1 class=\"text-5xl font-extrabold mb-4\">Welcome to MyStack Framework!</h1>
        <p class=\"text-lg text-slate-600 mb-8\">The ultimate, zero-dependency, single-class oriented framework.</p>
        <?= PHUI::ui(\"html:button\", [\"text\" => \"Read Documentation\", \"class\" => \"bg-blue-600 text-white px-6 py-3 rounded-full hover:bg-blue-700 transition\", \"@click\" => phjs(\"toast Hello from MyStack!\")]) ?>
    </main>
</body>
</html>
";
        generateFile($viewPath, $viewContent, "Demo View");
        
        success("Getting started demo code created successfully!");
        info("Run \"php mystack serve\" and open http://localhost:8000 in your browser to view the demo.");
        break;

    case 'serve':
        $port = $name ?? 8000;
        info("Starting MyStack intelligent dev server on http://localhost:$port");
        info("Press Ctrl+C to stop the server.");
        passthru("php -S localhost:$port");
        break;
        
    case 'cache:clear':
        $cacheDir = ROOT_DIR . '/src/cache';
        if (is_dir($cacheDir)) {
            $patterns = [
                $cacheDir . '/css/*.css',
                $cacheDir . '/js/*.js',
                $cacheDir . '/php/*.php',
            ];
            foreach ($patterns as $pattern) {
                foreach (glob($pattern) ?: [] as $file) {
                    if (is_file($file)) unlink($file);
                }
            }
            success("Application cache cleared instantly!");
        } else {
            warning("Cache directory not found or already empty.");
        }
        break;

    case 'update':
        try {
            if (!MyStackUpdater::run(ROOT_DIR, $args)) exit(1);
        } catch (Throwable $exception) {
            error('Update failed safely: ' . $exception->getMessage());
        }
        break;
        
    case 'doctor':
        $applyFixes = in_array('--fix', $args, true);
        if (!runDoctor([$appDir, $componentDir], $applyFixes)) {
            exit(1);
        }
        break;

    case 'audit':
        if (!runFrameworkAudit()) {
            exit(1);
        }
        break;

    case 'smoke':
        if (!runSmokeTests()) {
            exit(1);
        }
        break;

    default:
        $suggestion = MyStackBrain::suggestCommand((string) $command);
        $hint = $suggestion !== null ? "\nDid you mean: php mystack {$suggestion}" : '';
        error("Command not recognized: '$command'{$hint}\nRun 'php mystack help' to see all valid commands.");
        break;
}
