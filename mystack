        'make:controller',
        'make:model',
        'make:middleware',
        'make:component',
        'make:view',
        'get:started',
        'serve',
        'cache:clear',
        'update',
        'doctor',
        'audit',
        'smoke',
        'help',
    ];

    public static function analyze(string $root, string $appDir, string $componentDir): array {
        $files = self::phpFiles([$appDir, $componentDir, $root . '/index.php']);
        $classes = [];
        $classMethods = [];
        $routes = [];
        $routeHandlers = [];
        $routeNames = [];
        $imports = [];
        $views = [];
        $issues = [];
        $stats = [
            'files' => count($files),
            'lines' => 0,
            'bytes' => 0,
            'classes' => 0,
            'functions' => 0,
            'routes' => 0,
            'imports' => 0,
            'views' => 0,
            'raw_includes' => 0,
            'buffered_selects' => 0,
        ];

        foreach ($files as $file) {
            $content = file_get_contents($file);
            if ($content === false) {
                $issues[] = self::issue('warning', 'read', self::relative($root, $file), 'File could not be read.');
                continue;
            }

            $relative = self::relative($root, $file);
            $stats['bytes'] += strlen($content);
            $stats['lines'] += substr_count($content, "\n") + 1;

            $tokens = token_get_all($content);
            $tokenCount = count($tokens);
            $fileClasses = [];
            $fileFunctions = [];
            for ($index = 0; $index < $tokenCount; $index++) {
                $token = $tokens[$index];
                if (!is_array($token)) continue;

                if ($token[0] === T_CLASS) {
                    $previous = self::previousMeaningfulToken($tokens, $index);
                    if (is_array($previous) && $previous[0] === T_DOUBLE_COLON) continue;
                    $name = self::nextTokenText($tokens, $index, T_STRING);
                    if ($name !== null) {
                        $classes[$name][] = $relative;
                        $fileClasses[] = $name;
                        $stats['classes']++;
                    }
                } elseif ($token[0] === T_FUNCTION) {
                    $functionName = self::nextFunctionName($tokens, $index);
                    if ($functionName !== null) {
                        $fileFunctions[] = $functionName;
                        $stats['functions']++;
                    }
                } elseif (in_array($token[0], [T_REQUIRE, T_REQUIRE_ONCE, T_INCLUDE, T_INCLUDE_ONCE], true)) {
                    if (str_starts_with($relative, '/app/') || str_starts_with($relative, '/component/')) {
                        $stats['raw_includes']++;
                        $issues[] = self::issue(
                            'advice',
                            'architecture',
                            $relative,
                            "Use import('app:...') or import('component:...') instead of require/include."
                        );
                    }
                }
            }
            foreach ($fileClasses as $fileClass) {
                $classMethods[$fileClass] = array_values(array_unique(array_merge(
                    $classMethods[$fileClass] ?? [],
                    $fileFunctions
                )));
            }

            preg_match_all(
                '/\bimport\s*\((.*?)\)\s*;/is',
                $content,
                $importCalls,
                PREG_SET_ORDER
            );
            foreach ($importCalls as $call) {
                preg_match_all(
                    '/([\'"])(app|component):([^\'"]+)\1/i',
                    $call[1],
                    $importMatches,
                    PREG_SET_ORDER
                );
                foreach ($importMatches as $match) {
                    $imports[] = [
                        'type' => strtolower($match[2]),
                        'target' => $match[3],
                        'file' => $relative,
                    ];
                }
            }

            preg_match_all(
                '/PHRO::(get|post|put|delete|patch|any)\s*\(\s*([\'"])(.*?)\2/is',
                $content,
                $routeMatches,
                PREG_SET_ORDER
            );
            foreach ($routeMatches as $match) {
                $routes[] = [
                    'method' => strtoupper($match[1]),
                    'path' => $match[3],
                    'file' => $relative,
                ];
            }
            preg_match_all(
                '/PHRO::(get|post|put|delete|patch|any)\s*\(\s*([\'"])(.*?)\2\s*,\s*\[\s*([a-zA-Z_][a-zA-Z0-9_]*)::class\s*,\s*([\'"])([a-zA-Z_][a-zA-Z0-9_]*)\5\s*\]/is',
                $content,
                $handlerMatches,
                PREG_SET_ORDER
            );
            foreach ($handlerMatches as $match) {
                $routeHandlers[] = [
                    'method' => strtoupper($match[1]),
                    'path' => $match[3],
                    'class' => $match[4],
                    'action' => $match[6],
                    'file' => $relative,
                ];
            }
            preg_match_all('/->name\s*\(\s*([\'"])(.*?)\1\s*\)/is', $content, $nameMatches, PREG_SET_ORDER);
            foreach ($nameMatches as $match) {
                $routeNames[$match[2]][] = $relative;
            }

            preg_match_all(
                '/PHJC::view\s*\(\s*([\'"])([^\'"]+)\1/is',
                $content,
                $viewMatches,
                PREG_SET_ORDER
            );
            foreach ($viewMatches as $match) {
                $views[] = ['target' => $match[2], 'file' => $relative];
            }
            preg_match_all(
                '/PHRO::add\s*\(\s*([\'"])(GET|POST|PUT|DELETE|PATCH|OPTIONS|HEAD)\1\s*,\s*([\'"])(.*?)\3/is',
                $content,
                $addRouteMatches,
                PREG_SET_ORDER
            );
            foreach ($addRouteMatches as $match) {
                $routes[] = [
                    'method' => strtoupper($match[2]),
                    'path' => $match[4],
                    'file' => $relative,
                ];
            }

            $bufferedMatches = preg_match_all(
                '/PHDB::query\s*\(\s*([\'"])\s*SELECT\s+\*/i',
                $content
            );
            $stats['buffered_selects'] += $bufferedMatches === false ? 0 : $bufferedMatches;

            if (strlen($content) > 512 * 1024 && !str_starts_with($relative, '/library/')) {
                $issues[] = self::issue(
                    'advice',
                    'performance',
                    $relative,
                    'Large application file detected; review responsibilities and generated payload size.'
                );
            }
        }

        foreach ($classes as $name => $locations) {
            if (count($locations) > 1) {
                $issues[] = self::issue(
                    'critical',
                    'class-collision',
                    implode(', ', $locations),
                    "Class {$name} is declared more than once."
                );
            }
        }

        $availableTargets = ['app' => [], 'component' => []];
        foreach ($files as $file) {
            $relative = self::relative($root, $file);
            if (preg_match('#^/(app|component)/([^/]+)\.php$#i', $relative, $match)) {
                $availableTargets[strtolower($match[1])][strtolower($match[2])] = $relative;
            }
        }
        foreach ($imports as $import) {
            $target = strtolower(pathinfo(str_replace('\\', '/', $import['target']), PATHINFO_FILENAME));
            if (!isset($availableTargets[$import['type']][$target])) {
                $issues[] = self::issue(
                    'critical',
                    'missing-import',
                    $import['file'],
                    "Missing {$import['type']} import target: {$import['target']}"
                );
            }
        }
        foreach ($views as $view) {
            $target = strtolower(pathinfo(str_replace('\\', '/', $view['target']), PATHINFO_FILENAME));
            if (!isset($availableTargets['component'][$target])) {
                $issues[] = self::issue(
                    'critical',
                    'missing-view',
                    $view['file'],
                    "Missing component view target: {$view['target']}"
                );
            }
        }

        foreach ($routeNames as $routeName => $locations) {
            if ($routeName !== '' && count($locations) > 1) {
                $issues[] = self::issue(
                    'critical',
                    'route-name-collision',
                    implode(', ', array_unique($locations)),
                    "Duplicate route name: {$routeName}"
                );
            }
        }

        foreach ($routeHandlers as $handler) {
            if (!isset($classes[$handler['class']])) {
                $issues[] = self::issue(
                    'critical',
                    'missing-controller',
                    $handler['file'],
                    "{$handler['method']} {$handler['path']} references missing class {$handler['class']}."
                );
                continue;
            }
            if (!in_array($handler['action'], $classMethods[$handler['class']] ?? [], true)) {
                $issues[] = self::issue(
                    'critical',
                    'missing-action',
                    $handler['file'],
                    "{$handler['method']} {$handler['path']} references missing {$handler['class']}::{$handler['action']}()."
                );
            }
        }

        $routeIndex = [];
        foreach ($routes as $route) {
            $key = $route['method'] . ' ' . $route['path'];
            $routeIndex[$key][] = $route['file'];
        }
        foreach ($routeIndex as $route => $locations) {
            if (count($locations) > 1) {
                $issues[] = self::issue(
                    'critical',
                    'route-collision',
                    implode(', ', array_unique($locations)),
                    "Duplicate route: {$route}"
                );
            }
        }

        $indexContent = is_file($root . '/index.php')
            ? (string) file_get_contents($root . '/index.php')
            : '';
        if ($indexContent === '') {
            $issues[] = self::issue('critical', 'bootstrap', '/index.php', 'Application entry point is missing or empty.');
        } else {
            if (!str_contains($indexContent, 'PHRO::guard(')) {
                $issues[] = self::issue('advice', 'security', '/index.php', 'PHRO::guard() is not enabled.');
            }
            if (preg_match('/PHDE::debug\s*\(\s*true\s*\)/i', $indexContent)) {
                $issues[] = self::issue(
                    'info',
                    'environment',
                    '/index.php',
                    'Debug mode is enabled; keep it disabled on public production deployments.'
                );
            }
        }

        if ($stats['buffered_selects'] > 0) {
            $issues[] = self::issue(
                'info',
                'performance',
                '/app',
                "{$stats['buffered_selects']} buffered SELECT * call(s) found; use PHDB::fast() for large result processing."
            );
        }

        $stats['routes'] = count($routes);
        $stats['imports'] = count($imports);
        $stats['views'] = count($views);
        $critical = count(array_filter($issues, static fn(array $issue): bool => $issue['severity'] === 'critical'));
        $advice = count(array_filter($issues, static fn(array $issue): bool => $issue['severity'] === 'advice'));
        $infoCount = count(array_filter($issues, static fn(array $issue): bool => $issue['severity'] === 'info'));

        return [
            'status' => $critical === 0,
            'stats' => $stats,
            'classes' => $classes,
            'class_methods' => $classMethods,
            'routes' => $routes,
            'route_handlers' => $routeHandlers,
            'route_names' => $routeNames,
            'imports' => $imports,
            'views' => $views,
            'issues' => $issues,
            'counts' => ['critical' => $critical, 'advice' => $advice, 'info' => $infoCount],
            'fingerprint' => hash('sha256', json_encode([$stats, $classes, $routeIndex], JSON_UNESCAPED_SLASHES)),
        ];
    }

