    private static function testApp(array $options): int {
        ensureFrameworkRuntime();
        $files = glob(ROOT_DIR . '/app/*Test.php') ?: [];
        sort($files, SORT_NATURAL | SORT_FLAG_CASE);
        $rows = [];
        $passed = 0;
        $failed = 0;
        foreach ($files as $file) {
            $class = basename($file, '.php');
            $row = ['test' => $class, 'file' => '/app/' . $class . '.php', 'status' => false, 'assertions' => 0, 'message' => ''];
            if (!preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/', $class)) {
                $row['message'] = 'Test file name must be a valid PHP class name.';
            } else {
                try {
                    include_once $file;
                    if (!class_exists($class, false)) {
                        $row['message'] = 'File declares no class matching its name.';
                    } elseif (!method_exists($class, 'run')) {
                        $row['message'] = 'Missing static run(): array.';
                    } elseif (!(new ReflectionMethod($class, 'run'))->isStatic()) {
                        $row['message'] = 'run() must be static.';
                    } else {
                        $result = $class::run();
                        if (!is_array($result)) {
                            $row['message'] = 'run() must return an array with status and assertions.';
                        } else {
                            $assertions = (int) ($result['assertions'] ?? 0);
                            $row['assertions'] = $assertions;
                            $row['message'] = (string) ($result['message'] ?? '');
                            if (!empty($result['status']) && $assertions > 0) {
                                $row['status'] = true;
                            } elseif (!empty($result['status'])) {
                                $row['message'] = 'run() reported success without any assertion.';
                            }
                        }
                    }
                } catch (Throwable $error) {
                    $row['message'] = $error->getMessage()
                        . ' at ' . str_replace('\\', '/', str_replace(ROOT_DIR, '', $error->getFile())) . ':' . $error->getLine();
                }
            }
            if ($row['status']) { $passed++; } else { $failed++; }
            $rows[] = $row;
        }
        $result = [
            'status' => $failed === 0,
            'discovered' => count($files),
            'passed' => $passed,
            'failed' => $failed,
            'tests' => $rows,
        ];
        if (!empty($options['json'])) { self::emit($result, $options, $result['status'] ? 'info' : 'error'); return $result['status'] ? 0 : 1; }
        MyStackTui::section('Application tests');
        if ($files === []) {
            info('No application tests found; generate one with: php mystack make:test <Name>');
            return 0;
        }
        foreach ($rows as $row) {
            printColor($row['status'] ? '[PASS] ' : '[FAIL] ', $row['status'] ? '1;32' : '1;31');
            echo $row['test'] . ' - ' . $row['assertions'] . ' assertion(s)'
                . ($row['status'] || $row['message'] === '' ? '' : ': ' . $row['message'] . ' (' . $row['file'] . ')') . "\n";
        }
        MyStackTui::badge('PASSED', (string) $passed, '1;42;30', '+');
        MyStackTui::badge('FAILED', (string) $failed, $failed === 0 ? '1;42;30' : '1;41;97', $failed === 0 ? '+' : 'x');
        echo "\n";
        return $failed === 0 ? 0 : 1;
    }

    private static function parse(array $arguments): array {
        $args = []; $options = [];
        $booleanOptions = ['json', 'yes', 'no-interaction', 'verbose', 'daemon', 'once', 'fix', 'check', 'dry-run'];
        for ($index = 0; $index < count($arguments); $index++) {
            $argument = (string) $arguments[$index];
            if (str_starts_with($argument, '--')) {
                $pair = explode('=', substr($argument, 2), 2);
                $key = strtolower(trim($pair[0]));
                if ($key === '') continue;
                if (isset($pair[1])) $options[$key] = $pair[1];
                elseif (in_array($key, $booleanOptions, true)) $options[$key] = true;
                elseif (isset($arguments[$index + 1]) && !str_starts_with((string) $arguments[$index + 1], '-')) {
                    $options[$key] = (string) $arguments[++$index];
                } else $options[$key] = true;
            } elseif (str_starts_with($argument, '-') && strlen($argument) > 1) {
                foreach (str_split(substr($argument, 1)) as $flag) $options[$flag] = true;
            } else $args[] = $argument;
        }
        return [$args, $options];
    }

    private static function emit(mixed $data, array $options = [], string $kind = 'info'): void {
        if (!empty($options['json'])) {
            echo json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";
            return;
        }
        if (is_string($data)) { $kind === 'error' ? warning($data) : info($data); return; }
        if (is_array($data)) { MyStackTui::data($data); echo "\n"; return; }
        echo (string) $data . "\n";
    }

