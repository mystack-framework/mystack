    private static function inspectSource(string $source): array {
        $tokens = token_get_all($source); $classes = []; $methods = []; $functions = [];
        $braceDepth = 0; $pendingType = null; $classStack = []; $count = count($tokens);
        for ($i = 0; $i < $count; $i++) {
            $token = $tokens[$i];
            if (is_string($token)) {
                if ($token === '{') { $braceDepth++; if ($pendingType !== null) { $classStack[] = ['name' => $pendingType, 'depth' => $braceDepth]; $pendingType = null; } }
                elseif ($token === '}') { if ($classStack && end($classStack)['depth'] === $braceDepth) array_pop($classStack); $braceDepth = max(0, $braceDepth - 1); }
                continue;
            }
            $id = $token[0];
            if (in_array($id, [T_CURLY_OPEN, T_DOLLAR_OPEN_CURLY_BRACES], true)) { $braceDepth++; continue; }
            if (in_array($id, [T_CLASS, T_INTERFACE, T_TRAIT, defined('T_ENUM') ? T_ENUM : -1], true)) {
                $nameIndex = self::nextSignificant($tokens, $i + 1);
                $pendingType = '';
                if ($nameIndex !== null && is_array($tokens[$nameIndex]) && $tokens[$nameIndex][0] === T_STRING) { $pendingType = $tokens[$nameIndex][1]; $classes[] = $pendingType; }
                continue;
            }
            if ($id !== T_FUNCTION) continue;
            $nameIndex = self::nextSignificant($tokens, $i + 1, true);
            if ($nameIndex === null || !is_array($tokens[$nameIndex]) || $tokens[$nameIndex][0] !== T_STRING) continue;
            $name = $tokens[$nameIndex][1]; $open = self::findSymbol($tokens, $nameIndex + 1, '(');
            if ($open === null) continue;
            [$parameters, $close] = self::balancedText($tokens, $open, '(', ')');
            $return = ''; $cursor = self::nextSignificant($tokens, $close + 1);
            if ($cursor !== null && $tokens[$cursor] === ':') {
                for ($cursor++; $cursor < $count; $cursor++) { if ($tokens[$cursor] === '{' || $tokens[$cursor] === ';') break; $return .= self::tokenText($tokens[$cursor]); }
            }
            $modifiers = self::functionModifiers($tokens, $i); $insideClass = $classStack !== [];
            $record = ['name' => $name, 'static' => in_array(T_STATIC, $modifiers, true), 'parameters' => self::clean($parameters), 'return' => self::clean($return), 'summary' => self::precedingDoc($tokens, $i)];
            if ($insideClass && end($classStack)['name'] !== '' && !in_array(T_PRIVATE, $modifiers, true) && !in_array(T_PROTECTED, $modifiers, true)) $methods[] = $record;
            elseif (!$insideClass) { unset($record['static'], $record['summary']); $functions[] = $record; }
        }
        return ['classes' => array_values(array_unique($classes)), 'methods' => $methods, 'functions' => $functions];
    }
    private static function nextSignificant(array $tokens, int $start, bool $skipReference = false): ?int { for ($i = $start, $n = count($tokens); $i < $n; $i++) { $token = $tokens[$i]; if (is_array($token) && in_array($token[0], [T_WHITESPACE, T_COMMENT, T_DOC_COMMENT], true)) continue; if ($skipReference && ($token === '&' || (is_array($token) && defined('T_AMPERSAND_NOT_FOLLOWED_BY_VAR_OR_VARARG') && $token[0] === T_AMPERSAND_NOT_FOLLOWED_BY_VAR_OR_VARARG))) continue; return $i; } return null; }
    private static function findSymbol(array $tokens, int $start, string $symbol): ?int { for ($i = $start, $n = count($tokens); $i < $n; $i++) { if ($tokens[$i] === $symbol) return $i; if ($tokens[$i] === ';' || $tokens[$i] === '{') return null; } return null; }
    private static function balancedText(array $tokens, int $open, string $left, string $right): array { $depth = 0; $text = ''; for ($i = $open, $n = count($tokens); $i < $n; $i++) { $token = $tokens[$i]; if ($token === $left) { if ($depth++ > 0) $text .= $left; continue; } if ($token === $right && --$depth === 0) return [$text, $i]; if ($depth > 0) $text .= self::tokenText($token); } return [$text, $open]; }
    private static function tokenText(mixed $token): string { return is_array($token) ? $token[1] : (string) $token; }
    private static function functionModifiers(array $tokens, int $index): array { $found = []; for ($i = $index - 1; $i >= 0; $i--) { $token = $tokens[$i]; if (is_string($token) && in_array($token, [';', '{', '}'], true)) break; if (is_array($token) && in_array($token[0], [T_PUBLIC, T_PROTECTED, T_PRIVATE, T_STATIC, T_ABSTRACT, T_FINAL], true)) $found[] = $token[0]; } return $found; }
    private static function precedingDoc(array $tokens, int $index): string { for ($i = $index - 1; $i >= 0; $i--) { $token = $tokens[$i]; if (is_array($token) && $token[0] === T_DOC_COMMENT) return self::summary($token[1]); if (is_array($token) && in_array($token[0], [T_WHITESPACE, T_PUBLIC, T_PROTECTED, T_PRIVATE, T_STATIC, T_ABSTRACT, T_FINAL], true)) continue; break; } return ''; }
    private static function removeLegacyCrawlerFiles(): void {
        foreach (['robots.txt', 'docs/robots.txt', 'sitemap.xml', 'docs/sitemap.xml'] as $relative) {
            $path = ROOT_DIR . '/' . $relative; if (!is_file($path)) continue;
            $content = (string) file_get_contents($path);
            $isOldGenerated = str_contains($content, 'mystack-framework.github.io/mystack/sitemap.xml')
                || (str_contains($content, '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">') && str_contains($content, 'mystack-framework.github.io/mystack'));
            if ($isOldGenerated) @unlink($path);
        }
    }
    private static function summary(string $doc): string { $doc = preg_replace('/^\\s*\\/\\*\\*|\\*\\/\\s*$/', '', $doc) ?? ''; foreach (preg_split('/\\R/u', $doc) ?: [] as $line) { $line = trim(preg_replace('/^\\s*\\*\\s?/', '', $line) ?? ''); if ($line !== '' && !str_starts_with($line, '@')) return self::clean($line); } return ''; }
    private static function clean(string $text): string { return trim(preg_replace('/\\s+/', ' ', $text) ?? $text); }
    private static function json(array $value): string { return (string) json_encode($value, JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE|JSON_INVALID_UTF8_SUBSTITUTE) . "\n"; }
    private static function readJson(string $file): array { $value = is_file($file) ? json_decode((string) file_get_contents($file), true) : null; return is_array($value) ? $value : []; }
    private static function directory(string $path): void { if (!is_dir($path) && !mkdir($path, 0755, true) && !is_dir($path)) throw new RuntimeException('Unable to create: ' . $path); }
    private static function write(string $path, string $content): void {
        if (function_exists('mb_check_encoding') && !mb_check_encoding($content, 'UTF-8')) $content = mb_scrub($content, 'UTF-8');
        self::directory(dirname($path)); $temporary = $path . '.tmp-' . bin2hex(random_bytes(4));
        if (file_put_contents($temporary, $content, LOCK_EX) !== strlen($content) || !@rename($temporary, $path)) { @unlink($temporary); throw new RuntimeException('Unable to write: ' . $path); }
    }
}

