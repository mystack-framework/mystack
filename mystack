    private static function cliInstall(array $options): int {
        $targetOption = trim((string) ($options['target'] ?? ''));
        if (PHP_OS_FAMILY === 'Windows') {
            $base = $targetOption !== '' ? $targetOption : rtrim((string) (getenv('LOCALAPPDATA') ?: getenv('USERPROFILE')), '/\\') . '\\MyStack\\bin';
            if ($base === '' || str_contains($base, "\0")) throw new RuntimeException('A valid launcher target is required.');
            if (!is_dir($base) && !mkdir($base, 0755, true) && !is_dir($base)) throw new RuntimeException('Unable to create launcher directory: ' . $base);
            $launcher = rtrim($base, '/\\') . '\\mystack.cmd';
            $root = str_replace('%', '%%', ROOT_DIR);
            $content = "@echo off\r\nphp \"{$root}\\mystack\" %*\r\n";
        } else {
            $home = (string) getenv('HOME');
            $base = $targetOption !== '' ? $targetOption : rtrim($home, '/') . '/.local/bin';
            if ($base === '' || $base === '/.local/bin' || str_contains($base, "\0")) throw new RuntimeException('HOME or --target is required.');
            if (!is_dir($base) && !mkdir($base, 0755, true) && !is_dir($base)) throw new RuntimeException('Unable to create launcher directory: ' . $base);
            $launcher = rtrim($base, '/') . '/mystack';
            $php = str_replace("'", "'\\''", PHP_BINARY); $script = str_replace("'", "'\\''", ROOT_DIR . '/mystack');
            $content = "#!/usr/bin/env sh\nexec '{$php}' '{$script}' \"\$@\"\n";
        }
        $temporary = $launcher . '.tmp-' . bin2hex(random_bytes(4));
        if (file_put_contents($temporary, $content, LOCK_EX) !== strlen($content) || !@rename($temporary, $launcher)) {
            @unlink($temporary); throw new RuntimeException('Unable to install the launcher atomically.');
        }
        if (PHP_OS_FAMILY !== 'Windows') {
            @chmod($launcher, 0755);
            @chmod(ROOT_DIR . '/mystack', 0755);
        }
        $inPath = self::pathContains(dirname($launcher));
        self::emit([
            'status' => true, 'launcher' => $launcher, 'command' => 'mystack', 'php_mystack_preserved' => true,
            'project_direct_executable' => PHP_OS_FAMILY === 'Windows' ? null : is_executable(ROOT_DIR . '/mystack'),
            'path_ready' => $inPath,
            'next' => $inPath ? 'Run: mystack help' : 'Add this directory to PATH: ' . dirname($launcher),
        ], $options);
        return 0;
    }

