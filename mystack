    public static function help(?string $command = null): int {
        if ($command === null || $command === '') return self::renderList([]);
        foreach (self::commands() as $category => $commands) {
            foreach ($commands as $signature => $description) {
                if (strtok($signature, ' ') === $command) {
                    MyStackTui::header('Command reference  •  ' . $command);
                    echo "\n  {$description}\n\n  " . MyStackTui::paint('USAGE', '1;38;5;214') . ": mystack {$signature}\n";
                    echo "         php mystack {$signature}\n";
                    echo "\n  Global options: --json --yes --no-interaction --verbose --no-ansi\n\n";
                    return 0;
                }
            }
        }
        $custom = self::customCommand($command);
        if ($custom !== null) {
            echo "\n{$command}: " . $custom['description'] . "\n";
            return 0;
        }
        warning("No help is available for '{$command}'.");
        return 1;
    }

